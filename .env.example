# Copy to .env and fill in. Everything runs offline with the defaults below.

# Database: SQLite by default; Postgres in production (needs `pip install psycopg`).
DATABASE_URL=sqlite:///var/demo.sqlite
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/governed_ops

# LLM provider: "mock" (offline, default) or "openrouter".
LLM_PROVIDER=mock
OPENROUTER_API_KEY=your-key-here
# One spend-capped inference key per scheduled role (created by budget/provision_keys.py).
OPENROUTER_KEY_OPERATOR=your-key-here
OPENROUTER_KEY_COMPLIANCE=your-key-here
OPENROUTER_KEY_FINANCE=your-key-here
OPENROUTER_KEY_PAID=your-key-here
# The management key is held by a human and never placed on the agent host.
# OPENROUTER_MANAGEMENT_KEY=your-key-here

# Approvals and notifications
APPROVERS=approver-a,approver-b
CHAT_WEBHOOK_URL=

# Site under watch
SITE_BASE_URL=https://acme-lending.example.com
SITE_HOST=acme-lending.example.com
VERIFIER_HTTP=mock
WATCHDOG_SERVICES=nginx,postgresql,prequal-api
SAFE_BROWSING_API_KEY=your-key-here

# Lead router: both this flag AND an approved Tier-2 "Router go-live" row are required.
ROUTER_LIVE=0
